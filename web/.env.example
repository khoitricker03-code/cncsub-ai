# Local/offline defaults
LOCAL_MODEL=qwen2.5:7b
LOCAL_TRANSLATION_MODEL=qwen2.5:7b
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
TRANSLATION_PROVIDER=local
REWRITE_PROVIDER=local
JOB_QUEUE=local

# Optional cloud translation providers; leave blank for fully offline operation
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-2.0-flash

# Production authentication/database foundation (optional for local development)
AUTH_SECRET=replace-with-a-long-random-value
