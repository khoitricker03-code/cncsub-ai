# Local/offline defaults
LOCAL_MODEL=qwen2.5:7b
LOCAL_TRANSLATION_MODEL=qwen2.5:7b
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
TRANSLATION_PROVIDER=local
REWRITE_PROVIDER=local
JOB_QUEUE=local
# Optional absolute Python executable when python/python3/py are not on PATH
PYTHON_BIN=
# Demucs source-separation model. htdemucs is the supported default.
DEMUCS_MODEL=htdemucs
# Optional short, writable cache directory for downloaded Demucs models.
DEMUCS_CACHE_DIR=
# Optional separation/download timeout in milliseconds (default: 1800000).
DEMUCS_TIMEOUT_MS=

# Production authentication/database foundation (optional for local development)
AUTH_SECRET=replace-with-a-long-random-value
DATABASE_URL=postgresql://cncsub:cncsub@127.0.0.1:5432/cncsub
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
